FROM mcr.microsoft.com/dotnet/sdk:8.0

# Install Node.js, Python, and python3-venv
RUN apt-get update && apt-get install -y curl gnupg python3 python3-pip python3-venv \
    && curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y nodejs \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# Install Java JDK 17
RUN apt-get update && apt-get install -y openjdk-17-jdk && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

# Set JAVA_HOME for JDK 17
ENV JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64
ENV PATH="$JAVA_HOME/bin:$PATH"

# Install Maven 3.9.6
ENV MAVEN_VERSION=3.9.6
ENV MAVEN_HOME=/opt/maven
RUN curl -fsSL https://downloads.apache.org/maven/maven-3/${MAVEN_VERSION}/binaries/apache-maven-${MAVEN_VERSION}-bin.tar.gz \
    | tar -xz -C /opt && \
    mv /opt/apache-maven-${MAVEN_VERSION} ${MAVEN_HOME} && \
    ln -s ${MAVEN_HOME}/bin/mvn /usr/bin/mvn

# Verify the installations
RUN dotnet --version && node --version && python3 --version && pip3 --version && java -version && mvn -version

# Create and activate a virtual environment
WORKDIR /app
RUN python3 -m venv /app/venv
ENV PATH="/app/venv/bin:$PATH"

# Copy requirements.txt and install dependencies
COPY devagents/requirements.txt /app/devagents/requirements.txt
RUN /app/venv/bin/pip install --no-cache-dir --upgrade pip && \
    /app/venv/bin/pip install --no-cache-dir -r /app/devagents/requirements.txt

# Copy the devagents directory
COPY devagents /app/devagents

# Set the working directory to /app/devagents
WORKDIR /app/devagents

# Activate the virtual environment in the shell
RUN echo "source /app/venv/bin/activate" >> ~/.bashrc

# Add the "devagents" aliases
RUN echo "alias devagents='python devagents.py'" >> ~/.bashrc && \
    echo "alias run-tests='python run_tests.py'" >> ~/.bashrc && \
    echo "alias new-code='devagents --scenario NewCode'" >> ~/.bashrc && \
    echo "alias new-app='devagents --scenario NewApp'" >> ~/.bashrc && \
    echo "alias fix-build='devagents --scenario FixBuild'" >> ~/.bashrc && \
    echo "alias fix-tests='devagents --scenario FixTests'" >> ~/.bashrc

# Set the shell prompt
RUN echo "export PS1='\[\033[0;32m\]devagents# \[\033[0m\]'" >> ~/.bashrc

# Set the necessary environment variables
# npm_config_yes avoids prompts during npm installs
ENV npm_config_yes=true

# Start an interactive login shell, run hello.py, then stay in the shell
CMD ["/bin/bash", "--login", "-c", "python3 hello.py; exec bash"]
