FROM mcr.microsoft.com/dotnet/sdk:8.0

# Install the core utilities:
# - Python 3.x
# - Node.js 20.x
# - Java 17
# - Build tools
# - Set up locales and terminal
# All apt-get installs are combined for fewer layers and smaller image size
# Clean up apt cache in the same layer to avoid leftover files
RUN apt-get update && \
    apt-get install -y \
        curl \
        gnupg \
        python3 \
        python3-pip \
        python3-venv \
        libncurses5-dev \
        libncursesw5-dev \
        locales \
        locales-all \
        build-essential \
        ncurses-term \
        libreadline-dev \
        openjdk-17-jdk \
    && curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y nodejs \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# Set up locales for better curses compatibility
ENV LANG=en_US.UTF-8
ENV LANGUAGE=en_US.UTF-8
ENV LC_ALL=en_US.UTF-8
RUN locale-gen en_US.UTF-8

# Set terminal type for curses applications
ENV TERM=xterm-256color

# Set JAVA_HOME for JDK 17
ENV JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64
ENV PATH="$JAVA_HOME/bin:$PATH"

# Install Maven 3.9.6
ENV MAVEN_VERSION=3.9.6
ENV MAVEN_HOME=/opt/maven
RUN curl -fsSL https://archive.apache.org/dist/maven/maven-3/${MAVEN_VERSION}/binaries/apache-maven-${MAVEN_VERSION}-bin.tar.gz \
    | tar -xz -C /opt && \
    mv /opt/apache-maven-${MAVEN_VERSION} ${MAVEN_HOME} && \
    ln -s ${MAVEN_HOME}/bin/mvn /usr/bin/mvn

# Verify the installations
RUN dotnet --version && \
    node --version && \
    python3 --version && \
    pip3 --version && \
    java -version && \
    mvn -version

# Create and activate a Python virtual environment
WORKDIR /app
RUN python3 -m venv /app/venv
ENV PATH="/app/venv/bin:$PATH"

# Copy requirements.txt and install the packages
COPY devagents/requirements.txt /app/devagents/requirements.txt
RUN /app/venv/bin/pip install --no-cache-dir --upgrade pip && \
    /app/venv/bin/pip install --no-cache-dir -r /app/devagents/requirements.txt

# Copy the devagents source code
COPY devagents /app/devagents

# Set the working directory to /app/devagents
WORKDIR /app/devagents

# Activate the virtual environment in the shell
RUN echo "source /app/venv/bin/activate" >> ~/.bashrc

# Define the "devagents" aliases
RUN echo "alias devagents='python -m cli.devagents'" >> ~/.bashrc && \
    echo "alias run-tests='python -m tests.run_tests'" >> ~/.bashrc && \
    echo "alias new-code='devagents --workflow NewCode'" >> ~/.bashrc && \
    echo "alias modify-code='devagents --workflow ModifyCode'" >> ~/.bashrc && \
    echo "alias new-app='devagents --workflow NewApp'" >> ~/.bashrc && \
    echo "alias modify-app='devagents --workflow ModifyApp'" >> ~/.bashrc && \
    echo "alias fix-build='devagents --workflow FixBuild'" >> ~/.bashrc && \
    echo "alias fix-tests='devagents --workflow FixTests'" >> ~/.bashrc && \
    echo "alias ver='python -m cli.hello'" >> ~/.bashrc

# Set the shell prompt
RUN echo "export PS1='\[\033[0;32m\]devagents# \[\033[0m\]'" >> ~/.bashrc

# Set npm config to avoid prompts during npm installs
ENV npm_config_yes=true

# Start an interactive login shell, run hello.py, then stay in the shell
CMD ["/bin/bash", "--login", "-c", "python -m cli.hello; exec bash"]
